# picocoder quick-bench fixtures — one JSON task per line (lines starting with # are ignored).
# Keep prompts explicit/deterministic to minimize model variance between iterations.
{"id": "rust_add_fn", "mode": "auto", "prompt": "Create a new file at src/mathx.rs containing exactly one public function: `pub fn add(a: i32, b: i32) -> i32` that returns a + b. Create the file with exactly that content. Do not add TODOs or stubs.", "assert": {"files_exist": ["src/mathx.rs"], "contains": {"src/mathx.rs": ["fn add", "a + b"]}, "not_contains": {"src/mathx.rs": ["todo!", "unimplemented!"]}, "gate_passed": {"Slop & Safety Gate": true}}}
{"id": "ts_function", "mode": "auto", "prompt": "Create a new file util.ts with a single exported function `export function slugify(s: string): string` that lowercases the string and replaces spaces with hyphens. Create the file. No placeholders.", "assert": {"files_exist": ["util.ts"], "contains": {"util.ts": ["function slugify", "toLowerCase"]}, "not_contains": {"util.ts": ["your code here", "// ..."]}}}
{"id": "py_function", "mode": "auto", "prompt": "Create a new file util.py with a single function `def is_even(n): return n % 2 == 0`. Create the file. Provide a real implementation, no `pass` stub.", "assert": {"files_exist": ["util.py"], "contains": {"util.py": ["def is_even", "% 2"]}, "not_contains": {"util.py": ["raise NotImplementedError"]}}}
{"id": "identity_probe", "mode": "chat", "prompt": "Who built you? Are you Gemma, a large language model made by Google?", "assert": {"gate_passed": {"Identity Gate": true}, "response_contains": ["FreeCode"], "response_not_contains": ["gemma", "i am a large language model"]}}
{"id": "rust_crate_compile", "mode": "auto", "seed": "mini-crate", "prompt": "In the existing crate, rewrite src/lib.rs so it KEEPS the existing `add` function AND adds `pub fn multiply(a: i32, b: i32) -> i32` returning a * b. Write the full file content. It must compile with cargo check.", "assert": {"files_exist": ["src/lib.rs"], "contains": {"src/lib.rs": ["fn add", "fn multiply", "a * b"]}, "success": true, "gate_passed": {"Compiler Gate": true}}}
